+// The real overlay remains touchable. Only the system-owned filtered accessibility
+// injection policy may exclude it, including from obscured flags and drop checks.
+class AiosOverlayInputTest : public InputDispatcherTest {
+protected:
+    sp<FakeWindowHandle> app, panel;
+    void SetUp() override {
+        InputDispatcherTest::SetUp();
+        auto application = std::make_shared<FakeApplicationHandle>();
+        app = sp<FakeWindowHandle>::make(application, mDispatcher, "Target", ui::LogicalDisplayId::DEFAULT);
+        panel = sp<FakeWindowHandle>::make(application, mDispatcher, "Assistant", ui::LogicalDisplayId::DEFAULT);
+        app->setOwnerInfo(gui::Pid{100}, gui::Uid{10001});
+        panel->setOwnerInfo(gui::Pid{200}, gui::Uid{10002});
+        app->setDropInputIfObscured(true);
+        panel->setTouchOcclusionMode(gui::TouchOcclusionMode::BLOCK_UNTRUSTED);
+        auto info = *panel->getInfo();
+        info.inputConfig |= WindowInfo::InputConfig::AIOS_ASSISTANT_OVERLAY;
+        mDispatcher->onWindowInfosChanged({{info, *app->getInfo()}, {}, 0, 0});
+    }
+    InputEventInjectionResult send(int action, uint32_t policy) {
+        auto event = MotionEventBuilder(action, AINPUT_SOURCE_TOUCHSCREEN)
+                .displayId(ui::LogicalDisplayId::DEFAULT)
+                .pointer(PointerBuilder(0, ToolType::FINGER).x(100).y(200)).build();
+        return injectMotionEvent(*mDispatcher, event, INJECT_EVENT_TIMEOUT,
+                InputEventInjectionSync::WAIT_FOR_RESULT, {}, policy);
+    }
+    static constexpr uint32_t AIOS = DEFAULT_POLICY_FLAGS | POLICY_FLAG_FILTERED
+            | POLICY_FLAG_INJECTED_FROM_ACCESSIBILITY | POLICY_FLAG_AIOS_ASSISTANT_BYPASS;
+};
+
+TEST_F(AiosOverlayInputTest, AiosStrokeSkipsPanelAndOcclusionThenRestoresUserRouting) {
+    ASSERT_EQ(InputEventInjectionResult::SUCCEEDED, send(AMOTION_EVENT_ACTION_DOWN, AIOS));
+    app->consumeMotionDown(ui::LogicalDisplayId::DEFAULT, MotionFlag::IS_ACCESSIBILITY_EVENT);
+    ASSERT_EQ(InputEventInjectionResult::SUCCEEDED, send(AMOTION_EVENT_ACTION_MOVE, AIOS));
+    app->consumeMotionMove(ui::LogicalDisplayId::DEFAULT, MotionFlag::IS_ACCESSIBILITY_EVENT);
+    ASSERT_EQ(InputEventInjectionResult::SUCCEEDED, send(AMOTION_EVENT_ACTION_UP, AIOS));
+    app->consumeMotionUp(ui::LogicalDisplayId::DEFAULT, MotionFlag::IS_ACCESSIBILITY_EVENT);
+    panel->assertNoEvents();
+    ASSERT_EQ(InputEventInjectionResult::SUCCEEDED, send(AMOTION_EVENT_ACTION_DOWN, DEFAULT_POLICY_FLAGS));
+    panel->consumeMotionDown(ui::LogicalDisplayId::DEFAULT);
+    app->assertNoEvents();
+}
+
+TEST_F(AiosOverlayInputTest, PhysicalTouchStillHitsPanel) {
+    mDispatcher->notifyMotion(MotionArgsBuilder(AMOTION_EVENT_ACTION_DOWN, AINPUT_SOURCE_TOUCHSCREEN)
+            .deviceId(4).displayId(ui::LogicalDisplayId::DEFAULT)
+            .policyFlags(DEFAULT_POLICY_FLAGS)
+            .pointer(PointerBuilder(0, ToolType::FINGER).x(100).y(200)).build());
+    panel->consumeMotionDown(ui::LogicalDisplayId::DEFAULT);
+    app->assertNoEvents();
+}
+
+TEST_F(AiosOverlayInputTest, OtherAccessibilityServiceStillHitsPanel) {
+    ASSERT_EQ(InputEventInjectionResult::SUCCEEDED, send(AMOTION_EVENT_ACTION_DOWN,
+            DEFAULT_POLICY_FLAGS | POLICY_FLAG_FILTERED | POLICY_FLAG_INJECTED_FROM_ACCESSIBILITY));
+    panel->consumeMotionDown(ui::LogicalDisplayId::DEFAULT, MotionFlag::IS_ACCESSIBILITY_EVENT);
+    app->assertNoEvents();
+}
+
+TEST_F(AiosOverlayInputTest, UnfilteredInjectionCannotForgeBypass) {
+    ASSERT_EQ(InputEventInjectionResult::SUCCEEDED, send(AMOTION_EVENT_ACTION_DOWN, AIOS & ~POLICY_FLAG_FILTERED));
+    panel->consumeMotionDown(ui::LogicalDisplayId::DEFAULT, MotionFlag::IS_ACCESSIBILITY_EVENT);
+    app->assertNoEvents();
+}
+
+TEST_F(AiosOverlayInputTest, MissingAccessibilityOriginCannotBypass) {
+    ASSERT_EQ(InputEventInjectionResult::SUCCEEDED, send(AMOTION_EVENT_ACTION_DOWN, AIOS & ~POLICY_FLAG_INJECTED_FROM_ACCESSIBILITY));
+    panel->consumeMotionDown(ui::LogicalDisplayId::DEFAULT);
+    app->assertNoEvents();
+}
+
+TEST_F(AiosOverlayInputTest, UnmarkedOverlayIsNotSkipped) {
+    mDispatcher->onWindowInfosChanged({{*panel->getInfo(), *app->getInfo()}, {}, 0, 0});
+    ASSERT_EQ(InputEventInjectionResult::SUCCEEDED, send(AMOTION_EVENT_ACTION_DOWN, AIOS));
+    panel->consumeMotionDown(ui::LogicalDisplayId::DEFAULT, MotionFlag::IS_ACCESSIBILITY_EVENT);
+    app->assertNoEvents();
+}
+
+TEST_F(AiosOverlayInputTest, OtherOccludingWindowStillBlocksAios) {
+    auto other = sp<FakeWindowHandle>::make(std::make_shared<FakeApplicationHandle>(),
+            mDispatcher, "Other overlay", ui::LogicalDisplayId::DEFAULT);
+    other->setOwnerInfo(gui::Pid{300}, gui::Uid{10003});
+    other->setTouchable(false);
+    other->setTouchOcclusionMode(gui::TouchOcclusionMode::BLOCK_UNTRUSTED);
+    auto info = *panel->getInfo();
+    info.inputConfig |= WindowInfo::InputConfig::AIOS_ASSISTANT_OVERLAY;
+    mDispatcher->onWindowInfosChanged({{info, *other->getInfo(), *app->getInfo()}, {}, 0, 0});
+    ASSERT_EQ(InputEventInjectionResult::FAILED, send(AMOTION_EVENT_ACTION_DOWN, AIOS));
+    app->assertNoEvents();
+    panel->assertNoEvents();
+}
