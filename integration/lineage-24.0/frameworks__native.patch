+void InputDispatcher::DispatcherWindowInfo::excludeAiosAssistantOverlays() {
+    for (auto& [displayId, windows] : mWindowHandlesByDisplay) {
+        if (displayId != ui::LogicalDisplayId::DEFAULT) continue;
+        std::erase_if(windows, [](const sp<WindowInfoHandle>& window) {
+            return window->getInfo()->inputConfig.test(
+                    WindowInfo::InputConfig::AIOS_ASSISTANT_OVERLAY);
+        });
+    }
+}
