+    /** Change a stopped timer's duration without changing its stable ID. */
+    public void updateAiosTimer(Timer timer, long length, String label) {
+        enforceMainLooper();
+        if (timer.isRunning()) throw new IllegalArgumentException("Pause timer before changing duration");
+        if (length < 1000 || length > 86400000 || label == null || label.length() > 200)
+            throw new IllegalArgumentException("Invalid timer values");
+        mTimerModel.updateTimer(new Timer(timer.getId(), Timer.State.RESET, length, length,
+                Timer.UNUSED, Timer.UNUSED, length, label, timer.getDeleteAfterUse()));
+    }
