@@ -0,0 +1,65 @@
+//! Android file locks: std::fs locking is unsupported on Android in Rust 1.95.
+//! Keep the std API and use Bionic flock without weakening lock semantics.
+use std::fs::{File, TryLockError};
+use std::io;
+
+#[cfg(any(target_os = "android", all(test, unix)))]
+fn flock(file: &File, operation: libc::c_int) -> io::Result<()> {
+    use std::os::fd::AsRawFd;
+    loop {
+        // SAFETY: the borrowed File keeps this valid descriptor alive throughout the call.
+        if unsafe { libc::flock(file.as_raw_fd(), operation) } == 0 { return Ok(()); }
+        let error = io::Error::last_os_error();
+        if error.kind() != io::ErrorKind::Interrupted { return Err(error); }
+    }
+}
+#[cfg(any(target_os = "android", all(test, unix)))]
+fn try_flock(file: &File, operation: libc::c_int) -> Result<(), TryLockError> {
+    flock(file, operation | libc::LOCK_NB).map_err(|error| {
+        if error.kind() == io::ErrorKind::WouldBlock { TryLockError::WouldBlock }
+        else { TryLockError::Error(error) }
+    })
+}
+macro_rules! blocking {
+    ($name:ident, $operation:ident) => {
+        pub fn $name(file: &File) -> io::Result<()> {
+            #[cfg(target_os = "android")] { flock(file, libc::$operation) }
+            #[cfg(not(target_os = "android"))] { file.$name() }
+        }
+    };
+}
+macro_rules! nonblocking {
+    ($name:ident, $operation:ident) => {
+        pub fn $name(file: &File) -> Result<(), TryLockError> {
+            #[cfg(target_os = "android")] { try_flock(file, libc::$operation) }
+            #[cfg(not(target_os = "android"))] { file.$name() }
+        }
+    };
+}
+blocking!(lock, LOCK_EX);
+blocking!(lock_shared, LOCK_SH);
+blocking!(unlock, LOCK_UN);
+nonblocking!(try_lock, LOCK_EX);
+nonblocking!(try_lock_shared, LOCK_SH);
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    #[test]
+    fn contention_shared_and_release() {
+        let path=std::env::temp_dir().join(format!("codex-android-lock-{}", std::process::id()));
+        let a=File::create(&path).unwrap();
+        let b=File::options().read(true).write(true).open(&path).unwrap();
+        flock(&a,libc::LOCK_EX).unwrap();
+        assert!(matches!(try_flock(&b,libc::LOCK_EX),Err(TryLockError::WouldBlock)));
+        assert!(matches!(try_flock(&b,libc::LOCK_SH),Err(TryLockError::WouldBlock)));
+        flock(&a,libc::LOCK_UN).unwrap();
+        try_flock(&a,libc::LOCK_SH).unwrap();
+        try_flock(&b,libc::LOCK_SH).unwrap();
+        assert!(matches!(try_flock(&b,libc::LOCK_EX),Err(TryLockError::WouldBlock)));
+        drop(a);drop(b);
+        let c=File::options().read(true).write(true).open(&path).unwrap();
+        try_flock(&c,libc::LOCK_EX).unwrap();
+        drop(c);std::fs::remove_file(path).unwrap();
+    }
+}
