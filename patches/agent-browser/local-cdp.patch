diff --git a/cli/src/native/daemon_socket.rs b/cli/src/native/daemon_socket.rs
new file mode 100644
index 0000000..c0303c0
--- /dev/null
+++ b/cli/src/native/daemon_socket.rs
@@ -0,0 +1,117 @@
+#[cfg(unix)]
+use std::os::fd::{AsRawFd, FromRawFd, IntoRawFd};
+
+pub(crate) fn abstract_enabled() -> bool {
+    std::env::var("AGENT_BROWSER_DAEMON_ABSTRACT").as_deref() == Ok("1")
+}
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+fn abstract_name(session: &str) -> String {
+    use std::hash::{Hash, Hasher};
+    let mut hash = std::collections::hash_map::DefaultHasher::new();
+    crate::connection::get_socket_dir().hash(&mut hash);
+    session.hash(&mut hash);
+    format!("agent_browser_{:016x}", hash.finish())
+}
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+fn abstract_address(name: &str) -> (libc::sockaddr_un, libc::socklen_t) {
+    let mut address: libc::sockaddr_un = unsafe { std::mem::zeroed() };
+    address.sun_family = libc::AF_UNIX as libc::sa_family_t;
+    for (index, byte) in name.bytes().enumerate() {
+        address.sun_path[index + 1] = byte as libc::c_char;
+    }
+    let length = std::mem::offset_of!(libc::sockaddr_un, sun_path) + 1 + name.len();
+    (address, length as libc::socklen_t)
+}
+
+#[cfg(unix)]
+pub(crate) fn connect(session: &str) -> std::io::Result<std::os::unix::net::UnixStream> {
+    if !abstract_enabled() {
+        return std::os::unix::net::UnixStream::connect(
+            crate::connection::get_socket_dir().join(format!("{session}.sock")),
+        );
+    }
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    {
+        let socket = socket2::Socket::new(socket2::Domain::UNIX, socket2::Type::STREAM, None)?;
+        let stream = unsafe {
+            std::os::unix::net::UnixStream::from_raw_fd(socket.into_raw_fd())
+        };
+        let (address, length) = abstract_address(&abstract_name(session));
+        let result = unsafe {
+            libc::connect(
+                stream.as_raw_fd(),
+                &address as *const _ as *const libc::sockaddr,
+                length,
+            )
+        };
+        if result != 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+        return Ok(stream);
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "android")))]
+    Err(std::io::Error::new(
+        std::io::ErrorKind::Unsupported,
+        "abstract Unix sockets require Linux or Android",
+    ))
+}
+
+#[cfg(unix)]
+pub(crate) fn bind(
+    path: &std::path::Path,
+    session: &str,
+) -> std::io::Result<tokio::net::UnixListener> {
+    if !abstract_enabled() {
+        return tokio::net::UnixListener::bind(path);
+    }
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    {
+        let socket = socket2::Socket::new(socket2::Domain::UNIX, socket2::Type::STREAM, None)?;
+        socket.set_nonblocking(true)?;
+        let (address, length) = abstract_address(&abstract_name(session));
+        let bind_result = unsafe {
+            libc::bind(
+                socket.as_raw_fd(),
+                &address as *const _ as *const libc::sockaddr,
+                length,
+            )
+        };
+        if bind_result != 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+        socket.listen(16)?;
+        let listener = unsafe {
+            std::os::unix::net::UnixListener::from_raw_fd(socket.into_raw_fd())
+        };
+        return tokio::net::UnixListener::from_std(listener);
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "android")))]
+    Err(std::io::Error::new(
+        std::io::ErrorKind::Unsupported,
+        "abstract Unix sockets require Linux or Android",
+    ))
+}
+
+#[cfg(any(target_os = "linux", target_os = "android"))]
+pub(crate) fn peer_is_same_uid(stream: &tokio::net::UnixStream) -> bool {
+    let mut credentials: libc::ucred = unsafe { std::mem::zeroed() };
+    let mut length = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
+    let result = unsafe {
+        libc::getsockopt(
+            stream.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_PEERCRED,
+            &mut credentials as *mut _ as *mut libc::c_void,
+            &mut length,
+        )
+    };
+    result == 0 && credentials.uid == unsafe { libc::geteuid() }
+}
+
+#[cfg(all(unix, not(any(target_os = "linux", target_os = "android"))))]
+pub(crate) fn peer_is_same_uid(_stream: &tokio::net::UnixStream) -> bool {
+    true
+}
+
