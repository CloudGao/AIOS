index 0000000..c370fc8
--- /dev/null
+++ b/cli/src/native/cdp/local.rs
@@ -0,0 +1,223 @@
+//! Local CDP transport. Socket access is granted by the host OS, never by this URL.
+//! Discovery and WebSocket use separate connections to the same local endpoint.
+use std::time::Duration;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::UnixStream;
+
+const LIMIT: usize = 64 * 1024;
+const DEADLINE: Duration = Duration::from_secs(5);
+
+pub fn is_local(value: &str) -> bool {
+    value.starts_with("unix:") || value.starts_with("abstract:")
+}
+
+fn parts(value: &str) -> Result<(&str, Option<&str>), String> {
+    let (endpoint, target) = value.split_once('#').map_or((value, None), |(a,b)| (a, Some(b)));
+    if endpoint.bytes().any(|b| b < 32 || b == 127) {
+        return Err("Control character in local CDP endpoint".into());
+    }
+    if let Some(path) = endpoint.strip_prefix("unix:") {
+        if !path.starts_with('/') || path.len() > 100 || path.contains('#') {
+            return Err("Local CDP socket must be an absolute path of at most 100 bytes".into());
+        }
+    } else if let Some(name) = endpoint.strip_prefix("abstract:") {
+        if name.is_empty() || name.len() > 100 || !name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-' || b == b'.') {
+            return Err("Invalid abstract CDP socket name".into());
+        }
+    } else {
+        return Err("Expected unix: or abstract: CDP endpoint".into());
+    }
+    if let Some(target) = target { validate_target(target)?; }
+    Ok((endpoint, target))
+}
+
+fn validate_target(target: &str) -> Result<(), String> {
+    if !(target == "/devtools/browser" || target.starts_with("/devtools/browser/"))
+        || target.bytes().any(|b| b <= 32 || b >= 127 || matches!(b, b'#' | b'?' | b'\\'))
+        || target.contains("..") || target.len() > 2048 {
+        return Err("Expected a browser-level /devtools/browser path".into());
+    }
+    Ok(())
+}
+
+async fn open(endpoint: &str) -> Result<UnixStream, String> {
+    if let Some(path) = endpoint.strip_prefix("unix:") {
+        return UnixStream::connect(path).await.map_err(|e| format!("Local CDP connect: {e}"));
+    }
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    {
+        let name = endpoint.strip_prefix("abstract:").ok_or("Invalid local endpoint")?;
+        // Nonblocking connect avoids blocking the runtime on a full listener backlog.
+        let socket = socket2::Socket::new(socket2::Domain::UNIX, socket2::Type::STREAM, None).map_err(|e| e.to_string())?;
+        socket.set_nonblocking(true).map_err(|e| e.to_string())?;
+        use std::os::fd::{FromRawFd, IntoRawFd};
+        let raw = socket.into_raw_fd();
+        // SAFETY: raw has one owner, transferred from socket above.
+        let stream = unsafe { std::os::unix::net::UnixStream::from_raw_fd(raw) };
+        // std connect_addr creates its own blocking socket; use libc connect on ours.
+        use std::os::fd::AsRawFd;
+
+
+        let mut native: libc::sockaddr_un = unsafe { std::mem::zeroed() };
+        native.sun_family = libc::AF_UNIX as libc::sa_family_t;
+        for (i, byte) in name.bytes().enumerate() { native.sun_path[i + 1] = byte as libc::c_char; }
+        let length = (std::mem::offset_of!(libc::sockaddr_un, sun_path) + 1 + name.len()) as libc::socklen_t;
+        let result = unsafe { libc::connect(stream.as_raw_fd(), &native as *const _ as *const libc::sockaddr, length) };
+        if result < 0 {
+            let error = std::io::Error::last_os_error();
+            if error.raw_os_error() != Some(libc::EINPROGRESS) {
+                return Err(format!("Abstract CDP connect: {error}"));
+            }
+        }
+        let stream = UnixStream::from_std(stream).map_err(|e| e.to_string())?;
+        stream.writable().await.map_err(|e| e.to_string())?;
+        if let Some(error) = stream.take_error().map_err(|e| e.to_string())? { return Err(error.to_string()); }
+
+        Ok(stream)
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "android")))]
+    Err("Abstract sockets require Linux or Android".into())
+}
+
+fn body(response: &[u8]) -> Result<Vec<u8>, String> {
+    let split = response.windows(4).position(|w| w == b"\r\n\r\n").ok_or("Incomplete CDP HTTP headers")?;
+    let head = std::str::from_utf8(&response[..split]).map_err(|_| "Invalid CDP HTTP headers")?;
+    let mut lines = head.split("\r\n");
+    let status = lines.next().unwrap_or("");
+    if !(status.starts_with("HTTP/1.0 ") || status.starts_with("HTTP/1.1 ")) || !matches!(status.split_whitespace().nth(1), Some("200")) { return Err(format!("CDP discovery HTTP error: {status}")); }
+    let mut length = None;
+    for line in lines {
+        let (name, value) = line.split_once(':').ok_or("Malformed CDP HTTP header")?;
+        if name.eq_ignore_ascii_case("transfer-encoding") {
+            // HTTP/1.0 request below requires a non-chunked response. Fail explicitly.
+            return Err("Unsupported CDP transfer encoding".into());
+        }
+        if name.eq_ignore_ascii_case("content-length") {
+            if length.is_some() { return Err("Duplicate CDP content length".into()); }
+            length = Some(value.trim().parse::<usize>().map_err(|_| "Invalid CDP content length")?);
+        }
+    }
+    let body = &response[split + 4..];
+    if length.is_some_and(|n| n != body.len()) { return Err("Incomplete or excess CDP HTTP body".into()); }
+    Ok(body.to_vec())
+}
+
+pub async fn resolve(input: &str) -> Result<String, String> {
+    let (endpoint, target) = parts(input)?;
+    if target.is_some() { return Ok(input.to_owned()); }
+    tokio::time::timeout(DEADLINE, async {
+        let mut stream = open(endpoint).await?;
+        stream.write_all(b"GET /json/version HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n").await.map_err(|e| e.to_string())?;
+        let mut response = Vec::new();
+        loop {
+            let mut buffer = [0u8; 4096];
+            let count = stream.read(&mut buffer).await.map_err(|e| e.to_string())?;
+            if count == 0 { break; }
+            response.extend_from_slice(&buffer[..count]);
+            if response.len() > LIMIT { return Err("CDP discovery exceeds 64 KiB".into()); }
+            if let Some(split) = response.windows(4).position(|w| w == b"\r\n\r\n") {
+                let head = std::str::from_utf8(&response[..split]).map_err(|_| "Invalid CDP HTTP headers")?;
+                let mut lengths = Vec::new();
+                for line in head.split("\r\n").skip(1) {
+                    if let Some((name, value)) = line.split_once(':') {
+                        if name.eq_ignore_ascii_case("transfer-encoding") { return Err("Unsupported CDP transfer encoding".into()); }
+                        if name.eq_ignore_ascii_case("content-length") {
+                            lengths.push(value.trim().parse::<usize>().map_err(|_| "Invalid CDP content length")?);
+                        }
+                    }
+                }
+                if lengths.len() > 1 { return Err("Duplicate CDP content length".into()); }
+                if let Some(length) = lengths.first() {
+                    let total = (split + 4).checked_add(*length).ok_or("CDP content length overflow")?;
+                    if total > LIMIT { return Err("CDP discovery exceeds 64 KiB".into()); }
+                    if response.len() >= total { break; }
+                }
+            }
+        }
+        if response.len() > LIMIT { return Err("CDP discovery exceeds 64 KiB".into()); }
+        let info: serde_json::Value = serde_json::from_slice(&body(&response)?).map_err(|e| format!("Invalid CDP discovery JSON: {e}"))?;
+        let url = info.get("webSocketDebuggerUrl").and_then(|v| v.as_str()).ok_or("Missing browser WebSocket endpoint")?;
+        let url = url::Url::parse(url).map_err(|e| e.to_string())?;
+        if url.scheme() != "ws" || url.query().is_some() || url.fragment().is_some() || !url.username().is_empty() || url.password().is_some() {
+            return Err("Invalid local browser WebSocket URL".into());
+        }
+        validate_target(url.path())?;
+        // Ignore discovery host/port: never leave the selected local socket.
+        Ok(format!("{endpoint}#{}", url.path()))
+    }).await.map_err(|_| "Local CDP discovery timed out".to_string())?
+}
+
+pub async fn websocket(input: &str) -> Result<(tokio_tungstenite::WebSocketStream<UnixStream>, socket2::Socket), String> {
+    let (endpoint, path) = parts(input)?;
+    let path = path.ok_or("Local CDP endpoint must be resolved first")?;
+    tokio::time::timeout(DEADLINE, async {
+        let stream = open(endpoint).await?;
+        let socket = socket2::SockRef::from(&stream).try_clone().map_err(|e| e.to_string())?;
+        let config = tokio_tungstenite::tungstenite::protocol::WebSocketConfig {
+            max_message_size: Some(32 * 1024 * 1024), max_frame_size: Some(32 * 1024 * 1024), ..Default::default()
+        };
+        let (ws, _) = tokio_tungstenite::client_async_with_config(format!("ws://localhost{path}"), stream, Some(config))
+            .await.map_err(|e| format!("Local CDP WebSocket handshake: {e}"))?;
+        Ok((ws, socket))
+    }).await.map_err(|_| "Local CDP handshake timed out".to_string())?
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn rejects_unsafe_endpoints() {
+        for value in ["unix:relative", "abstract:", "abstract:bad/name", "unix:/tmp/a\r\nHost: x", "unix:/tmp/a#/devtools/page/x", "unix:/tmp/a#/devtools/browser/../x"] {
+            assert!(parts(value).is_err(), "{value}");
+        }
+        assert!(parts("abstract:chrome_devtools_remote").is_ok());
+        assert!(parts("unix:/tmp/cdp#/devtools/browser/abc").is_ok());
+    }
+    #[test]
+    fn http_fails_closed() {
+        assert_eq!(body(b"HTTP/1.0 200 OK\r\nContent-Length: 2\r\n\r\n{}").unwrap(), b"{}");
+        for data in [b"HTTP/1.0 403 Nope\r\n\r\n".as_slice(), b"HTTP/1.0 200 OK\r\nContent-Length: 3\r\n\r\n{}", b"HTTP/1.0 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"] {
+            assert!(body(data).is_err());
+        }
+    }
+    #[tokio::test]
+    async fn discovery_stays_on_selected_socket() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("cdp");
+        let server = tokio::net::UnixListener::bind(&path).unwrap();
+        let task = tokio::spawn(async move {
+            let (mut stream, _) = server.accept().await.unwrap();
+            let mut request = [0u8; 256];
+            stream.read(&mut request).await.unwrap();
+            let body = r#"{"webSocketDebuggerUrl":"ws://untrusted.example:9999/devtools/browser/test"}"#;
+            let reply = format!("HTTP/1.0 200 OK\r\nContent-Length: {}\r\n\r\n{body}", body.len());
+            for part in reply.as_bytes().chunks(7) { stream.write_all(part).await.unwrap(); }
+        });
+        let endpoint = format!("unix:{}", path.display());
+        assert_eq!(resolve(&endpoint).await.unwrap(), format!("{endpoint}#/devtools/browser/test"));
+        task.await.unwrap();
+    }
+    #[tokio::test]
+    async fn websocket_uses_shared_command_engine() {
+        use futures_util::{SinkExt, StreamExt};
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("cdp-ws");
+        let server = tokio::net::UnixListener::bind(&path).unwrap();
+        let task = tokio::spawn(async move {
+            let (stream, _) = server.accept().await.unwrap();
+            let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+            while let Some(Ok(message)) = ws.next().await {
+                if let tokio_tungstenite::tungstenite::Message::Text(text) = message {
+                    let command: serde_json::Value = serde_json::from_str(&text).unwrap();
+                    let reply = serde_json::json!({"id": command["id"], "result": {"product": "fixture"}});
+                    ws.send(tokio_tungstenite::tungstenite::Message::Text(reply.to_string())).await.unwrap();
+                    break;
+                }
+            }
+        });
+        let endpoint = format!("unix:{}#/devtools/browser/test", path.display());
+        let client = super::super::client::CdpClient::connect(&endpoint).await.unwrap();
+        let reply = client.send_command("Browser.getVersion", None, None).await.unwrap();
+        assert_eq!(reply["product"], "fixture");
+        task.await.unwrap();
+    }}
