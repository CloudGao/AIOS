+    boolean isAiosBackgroundExecutionAllowed(int uid, String packageName) {
+        if (!"os.aios.agent".equals(packageName)) return false;
+        final PackageManager pm = getPackageManagerForUser(UserHandle.getUserId(uid));
+        final ApplicationInfo info = getApplicationInfo(packageName, pm);
+        return info != null && info.uid == uid
+                && isConfiguredSignedAgent(packageName, getSigningDetails(packageName, pm))
+                && mGlobalUiConsentEnabled.test(UserHandle.getUserId(uid));
+    }
 
